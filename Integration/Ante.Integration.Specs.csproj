<Project Sdk="Microsoft.NET.Sdk">
    <!--
        Infrastructure-backed end-to-end specifications: Ante hosted in-process (WebApplicationFactory)
        against a real Chronicle kernel and MongoDB running in a container, plus minimal host event stores
        that exchange Ante's contract events through their outboxes and inboxes.

        Deliberately NOT part of Ante.slnx, so the default `dotnet test Ante.slnx` run (and CI) never needs
        Docker. Run with:

            dotnet test Integration/Ante.Integration.Specs.csproj

        See Documentation/local-development.md.
    -->
    <PropertyGroup>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
        <AssemblyName>Ante.Integration.Specs</AssemblyName>
        <RootNamespace>Ante.Integration</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="../Source/SharedSpecificationInstance.cs" Link="SharedSpecificationInstance.cs" />
        <Compile Remove="LegacyConsumer/**/*.cs" />
    </ItemGroup>

    <Target Name="BuildIsolatedLegacyConsumer" AfterTargets="Build" Condition="'$(DesignTimeBuild)' != 'true'">
        <Exec Command="dotnet build &quot;$(MSBuildProjectDirectory)/LegacyConsumer/LegacyConsumer.csproj&quot; --configuration $(Configuration) -nologo -v q" />
    </Target>

    <ItemGroup>
        <ProjectReference Include="../Source/Ante/Ante.csproj" />
        <ProjectReference Include="../Source/Ante.Contracts/Ante.Contracts.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Cratis.Fundamentals" />
        <PackageReference Include="xunit" />
        <PackageReference Include="xunit.runner.visualstudio">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.NET.Test.Sdk" />
        <PackageReference Include="Cratis.Specifications.XUnit" />
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
        <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
        <PackageReference Include="Testcontainers" />
        <PackageReference Include="SSH.NET" />
    </ItemGroup>

    <ItemGroup>
        <None Update="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <!--
        The replay specs drive the kernel's Observers service (replay, remove, observer state) - the gRPC contract the
        Workbench and the `cratis chronicle` CLI use. Cratis.Chronicle ships that contract assembly as a runtime-only
        asset (it is not in the package's ref/ folder), so compile against the same file the package puts at runtime.
    -->
    <Target Name="ReferenceChronicleContracts" AfterTargets="ResolvePackageAssets">
        <ItemGroup>
            <Reference Include="@(RuntimeCopyLocalItems)" Condition="'%(RuntimeCopyLocalItems.NuGetPackageId)' == 'Cratis.Chronicle' And '%(RuntimeCopyLocalItems.Filename)%(RuntimeCopyLocalItems.Extension)' == 'Cratis.Chronicle.Contracts.dll'" />
        </ItemGroup>
    </Target>
</Project>
