<Project>
    <Import Project="$(MSBuildThisFileDirectory)../Directory.Build.props" />

    <PropertyGroup>
        <!-- Ante.Contracts overrides this for its published package. -->
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Cratis.Fundamentals" />
    </ItemGroup>

    <!-- Ante runs inline specifications in Debug; Ante.Contracts keeps its dedicated runner. -->
    <PropertyGroup Condition="('$(MSBuildProjectName)' == 'Ante' And '$(Configuration)' == 'Release') Or '$(MSBuildProjectName)' == 'Ante.Contracts'">
        <DefaultItemExcludes>$(DefaultItemExcludes);**/for_*/**;**/when_*/**;**/when_*.cs;**/given/**</DefaultItemExcludes>
    </PropertyGroup>
</Project>
