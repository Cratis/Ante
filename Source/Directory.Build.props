<Project>
    <Import Project="$(MSBuildThisFileDirectory)../Directory.Build.props" />

    <PropertyGroup>
        <!-- Ante.Contracts overrides this for its published package. -->
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Cratis.Fundamentals" />
    </ItemGroup>

    <!-- Keep inline specifications beside the source, but compile them only in dedicated runners. -->
    <PropertyGroup Condition="'$(MSBuildProjectName)' == 'Ante' Or '$(MSBuildProjectName)' == 'Ante.Contracts'">
        <DefaultItemExcludes>$(DefaultItemExcludes);**/for_*/**;**/when_*/**;**/when_*.cs;**/given/**</DefaultItemExcludes>
    </PropertyGroup>
</Project>
