{
    "name": "ante",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite --config .frontend/vite.config.ts",
        "build": "vite build --config .frontend/vite.config.ts",
        "lint": "eslint --config .frontend/eslint.config.mjs --cache --quiet --fix",
        "lint:ci": "eslint --config .frontend/eslint.config.mjs --cache --quiet",
        "test": "vitest run --config .frontend/vite.config.ts",
        "test:watch": "vitest --watch --config .frontend/vite.config.ts",
        "compile": "tsc -b .frontend/tsconfig.json",
        "preview": "vite preview --config .frontend/vite.config.ts",
        "ci": "yarn test && yarn lint:ci && yarn compile",
        "dev:storybook": "storybook dev -c .frontend/.storybook --port 6006",
        "build-storybook": "storybook build -c .frontend/.storybook"
    },
    "dependencies": {
        "@cratis/arc": "^21.14.1",
        "@cratis/arc.react": "^21.14.1",
        "@cratis/arc.vite": "^21.14.1",
        "@cratis/components": "^4.1.1",
        "@cratis/components.primereact": "^4.1.1",
        "@cratis/fundamentals": "^7.17.1",
        "@primereact/core": "^11.1.0",
        "@primereact/headless": "^11.1.0",
        "@primereact/styles": "^11.1.0",
        "@primereact/ui": "^11.1.0",
        "@primeuix/themes": "^3.0.0",
        "@uiw/react-markdown-preview": "^5.2.1",
        "primeicons": "^8.0.0",
        "primereact": "^11.1.0",
        "react": "19.2.8",
        "react-dom": "19.2.8"
    },
    "devDependencies": {
        "@eslint/eslintrc": "3.3.6",
        "@eslint/js": "10.0.1",
        "@storybook/react": "^10.5.7",
        "@storybook/react-vite": "^10.5.7",
        "@tony.ganchev/eslint-plugin-header": "^3.4.4",
        "@types/chai": "5.2.3",
        "@types/chai-as-promised": "8.0.2",
        "@types/mocha": "10.0.10",
        "@types/node": "26.2.0",
        "@types/react": "19.2.18",
        "@types/react-dom": "19.2.4",
        "@types/sinon": "22.0.0",
        "@types/sinon-chai": "4.0.0",
        "@typescript-eslint/eslint-plugin": "8.67.0",
        "@typescript-eslint/parser": "8.67.0",
        "@vitejs/plugin-react": "6.0.5",
        "@vitest/coverage-v8": "4.1.10",
        "chai": "6.2.2",
        "chai-as-promised": "8.0.2",
        "eslint": "10.8.1",
        "eslint-config-prettier": "10.1.8",
        "eslint-plugin-import": "2.32.0",
        "eslint-plugin-no-null": "1.0.2",
        "eslint-plugin-prettier": "5.5.6",
        "eslint-plugin-react": "7.37.5",
        "eslint-plugin-react-hooks": "7.1.1",
        "eslint-plugin-react-refresh": "0.5.4",
        "globals": "17.11.0",
        "mocha": "11.8.0",
        "prettier": "3.9.6",
        "sinon": "22.1.0",
        "sinon-chai": "4.0.1",
        "storybook": "^10.5.7",
        "ts-node": "10.9.2",
        "tsconfig-paths": "4.2.0",
        "typescript": "6.0.3",
        "typescript-eslint": "8.67.0",
        "vite": "8.2.1",
        "vite-tsconfig-paths": "6.1.1",
