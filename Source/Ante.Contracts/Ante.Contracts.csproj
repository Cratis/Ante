<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>

        <!-- Must match PackageId below. The .NET SDK records a project reference's "project" library
             in the referencing project's deps.json under its NuGet package identity (PackageId, or
             AssemblyName when PackageId is unset) - not under AssemblyName when the two diverge.
             Cratis.Fundamentals' type-discovery (ProjectReferencedAssemblies, used by every Chronicle
             app to find [EventType]/[Reactor]/[ReadModel] types) resolves that deps.json library name
             with Assembly.Load(name). With AssemblyName "Ante.Contracts" and PackageId
             "Cratis.Ante.Contracts", the deps.json project entry was "Cratis.Ante.Contracts" while the
             physical output was Ante.Contracts.dll - Assembly.Load("Cratis.Ante.Contracts") failed to
             resolve, so every event type, reactor, and read model defined in this project was silently
             invisible to discovery everywhere: the running app, and every Chronicle*Scenario spec.
             Aligning AssemblyName to PackageId makes the physical assembly resolvable by the name the
             deps.json actually records. -->
        <AssemblyName>Cratis.Ante.Contracts</AssemblyName>
        <RootNamespace>Ante.Contracts</RootNamespace>

        <!-- NuGet package identity - the only packable project in this repo, published via
             trusted publishing from .github/workflows/publish.yml on every push to main.
             Source/Directory.Build.props sets IsPackable false for everything under Source/
             ("nothing under Source is published as a NuGet package"); this is the one
             project that overrides it back to true. -->
        <IsPackable>true</IsPackable>
        <PackageId>Cratis.Ante.Contracts</PackageId>
        <Authors>all contributors</Authors>
        <Copyright>Copyright Cratis</Copyright>
        <Description>The invitation and lobby event contracts for Ante — Cratis's signed-invitation system and tenant lobby.</Description>
        <PackageTags>cratis;ante;invitations;event-sourcing;chronicle</PackageTags>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <RepositoryType>git</RepositoryType>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <RepositoryUrl>https://github.com/Cratis/Ante</RepositoryUrl>
        <PackageProjectUrl>https://github.com/Cratis/Ante</PackageProjectUrl>
        <PackageReadmeFile>README.md</PackageReadmeFile>

        <GenerateAssemblyTitleAttribute>true</GenerateAssemblyTitleAttribute>
        <GenerateAssemblyDescriptionAttribute>true</GenerateAssemblyDescriptionAttribute>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Cratis.Chronicle" />
    </ItemGroup>

    <ItemGroup>
        <AssemblyAttribute Include="Cratis.Chronicle.Events.EventStoreAttribute">
            <_Parameter1>Ante</_Parameter1>
        </AssemblyAttribute>
    </ItemGroup>

    <ItemGroup>
        <None Include="$(MSBuildThisFileDirectory)../../README.md" Pack="true" PackagePath="/" />
    </ItemGroup>
</Project>
